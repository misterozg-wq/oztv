<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:maxWidth="520dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Entrez vos identifiants pour vous connecter"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/boxXtream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etHost"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_bg"
                android:paddingHorizontal="14dp"
                android:hint="Serveur (ex. http://exemple.com:8080)"
                android:textColorHint="@color/text_dim"
                android:textColor="@color/text"
                android:inputType="textUri"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etUser"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_bg"
                android:paddingHorizontal="14dp"
                android:hint="Utilisateur"
                android:textColorHint="@color/text_dim"
                android:textColor="@color/text"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etPass"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_bg"
                android:paddingHorizontal="14dp"
                android:hint="Mot de passe"
                android:textColorHint="@color/text_dim"
                android:textColor="@color/text"
                android:inputType="textPassword"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/boxM3u"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etM3u"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_bg"
                android:paddingHorizontal="14dp"
                android:hint="Lien M3U (http://.../get.php?...)"
                android:textColorHint="@color/text_dim"
                android:textColor="@color/text"
                android:inputType="textUri"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF6B6B"
            android:textSize="14sp"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/connect"
            android:textColor="@color/text"
            android:textStyle="bold"
            android:background="@drawable/btn_bg"
            android:layout_marginTop="8dp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
